# Copy to .env and fill in real values. Never commit .env.
#   cp .env.example .env

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=elearning
POSTGRES_USER=elearning
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=change-me
REDIS_PORT=6380
REDIS_MAXMEMORY=256mb

# --- MinIO (S3-compatible object storage) -----------------------------------
MINIO_ROOT_USER=elearning
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_MEDIA_BUCKET=elearning
MINIO_PUBLIC_BUCKET=elearning-public

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=elearning
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

# --- Mailpit (dev SMTP sink) ------------------------------------------------
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026

# --- Application (Spring Boot, run on the host) -----------------------------
# The dev profile derives sane defaults from the values above; override here
# only when you change a compose port or point at non-local infrastructure.
SERVER_PORT=8081
# DB_URL=jdbc:postgresql://localhost:5433/elearning
# DB_USERNAME=elearning
# DB_PASSWORD=
# REDIS_HOST=localhost
# RABBITMQ_HOST=localhost
# RABBITMQ_USERNAME=elearning
# MAIL_HOST=localhost
# MAIL_PORT=1026
MAIL_FROM=no-reply@elearning.local
# --- Mailgun (set MAIL_PROVIDER=mailgun to use the HTTP API instead of SMTP) -
# MAIL_PROVIDER=mailgun
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.yourdomain.com
# EU-region domains need the EU host, or Mailgun answers 401:
# MAILGUN_BASE_URL=https://api.eu.mailgun.net

# The SMTP settings below apply only when MAIL_PROVIDER is smtp (the default).
# A real SMTP provider needs auth and TLS; Mailpit needs neither, so both are off.
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true

# --- Accounts and email links -----------------------------------------------
# Where verification and password-reset links point. This is the FRONT END,
# not the API: the user lands on a page that posts the token back. Get this
# wrong and every emailed link is dead.
APP_BASE_URL=http://localhost:3000
# Set false only where identity is established some other way; accounts are
# then created ACTIVE and no verification mail is sent.
# REQUIRE_EMAIL_VERIFICATION=true
# EMAIL_VERIFICATION_TTL=2d
# PASSWORD_RESET_TTL=30m
# STORAGE_ENDPOINT=http://localhost:9100
# STORAGE_ACCESS_KEY=elearning
# STORAGE_SECRET_KEY=

# --- JWT signing ------------------------------------------------------------
# HS256 requires at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
# Short on purpose: a signed JWT cannot be withdrawn, so this is how long a
# revoked session stays usable. The refresh token is the revocable half.
# JWT_ACCESS_TOKEN_TTL=15m
# JWT_REFRESH_TOKEN_TTL=30d
# JWT_ISSUER=elearning
# JWT_ACCESS_TOKEN_TTL=1h
